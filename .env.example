# 圖像生成設定 (可選: kie 或 google)
IMAGE_PROVIDER=kie
KIE_API_KEY=your_kie_api_key_here
KIE_BASE_URL=https://api.kie.ai
KIE_MODEL=nano-banana-2-lite
KIE_POLL_INTERVAL_SECONDS=5
KIE_TIMEOUT_SECONDS=900

# Google 官方產圖設定 (IMAGE_PROVIDER=google 時使用)
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets 設定
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
SPREADSHEET_ID=your_spreadsheet_id_here
SHEET_NAME=工作表1

# Google Sheet 欄位對應
PROMPT_COLUMN=prompt
STATUS_COLUMN=status
IMAGE_URL_COLUMN=image_url
IMAGE_PATH_COLUMN=image_path
MODEL_COLUMN=model
GENERATED_AT_COLUMN=generated_at
ERROR_COLUMN=error

# 執行參數設定
PENDING_STATUSES=,TODO,QUEUED,RETRY
IMAGE_ASPECT_RATIO=1:1
IMAGE_MIME_TYPE=image/jpeg
OUTPUT_DIR=./output
BATCH_LIMIT=5
POLL_INTERVAL_SECONDS=60

# 服務安全設定
SESSION_SECRET=your_secure_random_session_secret_here
